{
	"name": "dsh-toolbox",
	"version": "2.3.1",
	"description": "DSH 个人工具箱：see_image 识图转述＋memory 记忆索引注入＋dispatch 工作流纪律注入。",
	"license": "MIT",
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-plugin-manager",
				"@deepseek-ai/dsh-api-remotes"
			]
		}
	},
	"files": [
		"lib/**",
		"test/**",
		"scripts/**",
		"locale/**",
		"cordis.patch.yml",
		"icon.svg",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test",
		"check:memory": "node scripts/check-memory-index.mjs",
		"bump": "node scripts/bump-version.mjs"
	},
	"engines": {
		"node": ">=18",
		"dsh": ">=0.2.0-rc.2 <0.3.0"
	},
	"keywords": [
		"deepseek-harness",
		"dsh",
		"cordis",
		"plugin",
		"memory",
		"vision",
		"dispatch"
	],
	"peerDependencies": {
		"@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
		"@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
		"@deepseek-ai/schemastery": ">=3.18.4 <4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/maochouchou4-create/dsh-toolbox.git"
	}
}
