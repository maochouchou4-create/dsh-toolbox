{
  "rows": [
    {
      "batchType": "纯后端管线批",
      "gate1": [
        "锚点核对",
        "事实校准",
        "工程复用"
      ],
      "gate2": [
        "设计七维·终审",
        "连带面",
        "性能放大问",
        "性质测试问",
        "蜕变关系问"
      ]
    },
    {
      "batchType": "用户可见功能批",
      "gate1": [
        "锚点核对",
        "事实校准",
        "砍刀",
        "场景走查·升级版"
      ],
      "gate2": [
        "设计七维·终审",
        "连带面",
        "GUI 目检"
      ]
    },
    {
      "batchType": "跨端契约批",
      "gate1": [
        "锚点核对",
        "事实校准"
      ],
      "gate2": [
        "契约一致性",
        "连带面"
      ],
      "formNotes": {
        "连带面": "按双仓口径执行——契约两侧的仓都要 grep，不只 grep 改动侧"
      },
      "note": "跨端契约改动＝两侧仓同时核"
    },
    {
      "batchType": "配置/迁移批",
      "gate1": [
        "锚点核对"
      ],
      "gate2": [
        "迁移执行核对",
        "连带面",
        "蜕变关系问"
      ]
    },
    {
      "batchType": "机械搬运/小修",
      "gate1": null,
      "gate2": [
        "连带面",
        "金主比对"
      ]
    },
    {
      "batchType": "新功能·形态未定",
      "kind": "special",
      "needsBase": true,
      "gate1": [
        "锚点核对",
        "第一性原理"
      ],
      "gate2": null,
      "note": "gate2 按 baseBatchType（落点批型）主行取"
    },
    {
      "batchType": "涉鉴权/上传/输入",
      "kind": "addon",
      "gate1": [
        "安全清单行"
      ],
      "gate2": [
        "安全专项"
      ]
    },
    {
      "batchType": "大数值/通知批",
      "kind": "addon",
      "gate1": [
        "数字口径问"
      ],
      "gate2": [
        "设计七维·终审",
        "连带面"
      ]
    },
    {
      "batchType": "修复批",
      "kind": "special",
      "needsBase": true,
      "needsRootCause": true,
      "gate1": null,
      "gate2": null,
      "note": "按 baseBatchType（原批型）主行组合＋默认二轮复核"
    },
    {
      "batchType": "直做批",
      "kind": "special",
      "gate1": null,
      "gate2": [
        "设计七维·终审",
        "连带面"
      ],
      "note": "无方案直做批＝门二双路起步，最大化口径可加挂；不带 baseBatchType"
    },
    {
      "batchType": "大工程方案",
      "kind": "addon",
      "gate1": [
        "施工走查"
      ],
      "gate2": null,
      "note": "≥3 批或含跨批依赖的方案走查加挂——扮演施工者沙盘推演，把断头引用/时序倒置/落点缺失/语义未钉/调用面踩坑在施工前抓出"
    }
  ],
  "rhythm": [
    {
      "when": {
        "batchType": [
          "修复批"
        ]
      },
      "note": "默认二轮复核；修复方案堆到 ≥2 个守卫/特判＝停下回看底层再定修法"
    },
    {
      "when": {
        "batchType": [
          "机械搬运/小修"
        ]
      },
      "note": "行为保持搬运不单独派复核（机器门＋金主比对先行），攒到方案终审；小批免派：≤2 文件＋机械改动＋无新守门断言＋不动共享函数/命令→提交前那道也免，判据不满足＝按节奏走不省代理数（≤2 文件＝用户拍板口径，出处 batch-subagent-process）；更小的通用规模免派另见 diffLines 条（那一档按行数×文件数给，不看批型）"
    },
    {
      "when": {
        "batchType": [
          "跨端契约批",
          "用户可见功能批"
        ]
      },
      "note": "风险批当批派（地基错＝上层白干）：findings 裁决＋修复落库后才发下一批；清账式互不依赖小批可攒终审"
    },
    {
      "when": {
        "batchType": [
          "配置/迁移批"
        ]
      },
      "note": "免派复核主场景（无行为面，机器门可兜）；有沾边面按配对加挂"
    },
    {
      "when": {
        "batchType": [
          "直做批"
        ]
      },
      "note": "无方案直做＝门二双路起步不可降"
    },
    {
      "when": {
        "batchType": [
          "新功能·形态未定"
        ]
      },
      "note": "先过 forms 全集定形态再施工"
    },
    {
      "when": {
        "stage": [
          "施工"
        ]
      },
      "note": "机器门前置：typecheck/lint/测试全绿才派门二（也才接受施工上报）——机器抓得到的低级错不花代理数"
    },
    {
      "when": {
        "provider": [
          "minimax-cn"
        ]
      },
      "note": "Flash 施工批只设上限：预计净 diff 超约 500 行或结构性跨 3+ 模块→拆批再派；机械搬运批例外（行为保持＋金主比对兜底，可千行级——与 plan-spec 分批纪律一致）；不设下限——小活由直做批与「几行级主会话顺手做」既有口径承载。500/3+＝初始标定（无实测基线），复盘按台账调；1000 行复核侧规模关卡承自现场、拆批在前关卡在后"
    },
    {
      "when": {
        "stage": [
          "门二"
        ]
      },
      "note": "终审（多批收尾全量双复核）另于门二：终审不可替代批内双路，降路必须先问用户"
    },
    {
      "when": {
        "stage": [
          "门一"
        ]
      },
      "note": "大工程方案（≥3 批或含跨批依赖）加挂「大工程方案」行走施工走查——施工前沙盘推演：锚点实地核/逐字档对活源/装配路径真调一次/批间产物→前提衔接"
    },
    {
      "when": {
        "stage": [
          "门二"
        ],
        "diffLines": {
          "max": 5
        },
        "changedFiles": {
          "max": 1
        }
      },
      "note": "本规模建议直修＋单测（对齐 AGENTS.md 几行级小修口径）——确要派发请把理由记台账 note"
    }
  ]
}
