{
  "rows": [
    {
      "batchType": "纯后端管线批",
      "gate1": [
        "锚点核对",
        "事实校准",
        "工程复用",
        "砍刀"
      ],
      "gate2": [
        "设计七维·终审",
        "连带面",
        "砍刀·diff"
      ]
    },
    {
      "batchType": "用户可见功能批",
      "gate1": [
        "锚点核对",
        "事实校准",
        "砍刀",
        "场景走查·升级版"
      ],
      "gate2": [
        "设计七维·终审",
        "连带面",
        "GUI 目检",
        "砍刀·diff"
      ]
    },
    {
      "batchType": "跨端契约批",
      "gate1": [
        "锚点核对",
        "事实校准",
        "砍刀"
      ],
      "gate2": [
        "契约一致性",
        "连带面",
        "砍刀·diff"
      ],
      "formNotes": {
        "连带面": "按双仓口径执行——契约两侧的仓都要 grep，不只 grep 改动侧"
      }
    },
    {
      "batchType": "配置/迁移批",
      "gate1": [
        "锚点核对",
        "砍刀"
      ],
      "gate2": [
        "迁移执行核对",
        "连带面",
        "蜕变关系问",
        "砍刀·diff"
      ]
    },
    {
      "batchType": "机械搬运/小修",
      "gate1": null,
      "gate2": [
        "连带面",
        "金主比对",
        "砍刀·diff"
      ]
    },
    {
      "batchType": "新功能·形态未定",
      "kind": "special",
      "needsBase": true,
      "gate1": [
        "锚点核对",
        "第一性原理",
        "砍刀"
      ],
      "gate2": null
    },
    {
      "batchType": "涉鉴权/上传/输入",
      "kind": "addon",
      "gate1": [
        "安全清单行"
      ],
      "gate2": [
        "安全专项"
      ]
    },
    {
      "batchType": "大数值/通知批",
      "kind": "addon",
      "gate1": [
        "数字口径问"
      ],
      "gate2": [
        "设计七维·终审",
        "连带面"
      ]
    },
    {
      "batchType": "修复批",
      "kind": "special",
      "needsBase": true,
      "needsRootCause": true,
      "gate1": null,
      "gate2": null
    },
    {
      "batchType": "直做批",
      "kind": "special",
      "gate1": null,
      "gate2": [
        "设计七维·终审",
        "连带面",
        "砍刀·diff"
      ]
    },
    {
      "batchType": "大工程方案",
      "kind": "addon",
      "gate1": [
        "施工走查"
      ],
      "gate2": null
    }
  ],
  "rhythm": [
    {
      "when": {
        "batchType": [
          "修复批"
        ]
      },
      "note": "默认二轮复核；修复方案堆到 ≥2 个守卫/特判＝停下回看底层再定修法"
    },
    {
      "when": {
        "batchType": [
          "机械搬运/小修"
        ]
      },
      "note": "行为保持搬运不单独派复核（机器门＋金主比对先行），攒到方案终审；小批免派：≤2 文件＋机械改动＋无新守门断言＋不动共享函数/命令→提交前那道也免，判据不满足＝按节奏走不省代理数（≤2 文件＝用户拍板口径，出处 batch-subagent-process）；更小的通用规模免派另见 diffLines 条（那一档按行数×文件数给，不看批型）"
    },
    {
      "when": {
        "batchType": [
          "跨端契约批",
          "用户可见功能批"
        ]
      },
      "note": "风险批当批派（地基错＝上层白干）：findings 裁决＋修复落库后才发下一批；清账式互不依赖小批可攒终审"
    },
    {
      "when": {
        "batchType": [
          "配置/迁移批"
        ]
      },
      "note": "免派复核主场景（无行为面，机器门可兜）；有沾边面按配对加挂"
    },
    {
      "when": {
        "batchType": [
          "直做批"
        ]
      },
      "note": "无方案直做＝门二双路起步不可降"
    },
    {
      "when": {
        "batchType": [
          "新功能·形态未定"
        ]
      },
      "note": "先过 forms 全集定形态再施工"
    },
    {
      "when": {
        "stage": [
          "施工"
        ]
      },
      "note": "机器门前置：typecheck/lint/测试全绿才派门二（也才接受施工上报）——机器抓得到的低级错不花代理数"
    },
    {
      "when": {
        "changedFiles": {
          "min": 10
        }
      },
      "note": "单段施工＝一个可独立自验的闭环；flash 路线参考上限约 10 文件或 5 条任务块——超出默认拆、主会话可按耦合度裁量不拆（裁量型不是硬门，用户定调『不超出也不死板』）；强依赖链切段、段间主会话收自验证据再派下一段；文件域不相交才并行"
    },
    {
      "when": {
        "stage": [
          "门二"
        ]
      },
      "note": "终审（多批收尾全量双复核）另于门二：终审不可替代批内双路，降路必须先问用户"
    },
    {
      "when": {
        "stage": [
          "门一"
        ]
      },
      "note": "大工程方案（≥3 批或含跨批依赖）加挂「大工程方案」行走施工走查——施工前沙盘推演：锚点实地核/逐字档对活源/装配路径真调一次/批间产物→前提衔接"
    },
    {
      "when": {
        "stage": [
          "门二"
        ],
        "diffLines": {
          "max": 5
        },
        "changedFiles": {
          "max": 1
        }
      },
      "note": "本规模建议直修＋单测（对齐 AGENTS.md 几行级小修口径）——确要派发请把理由记台账 note；动了共享面（工具参数面、数据表、模板、契约）照走门禁，规模小不是免门禁的理由"
    },
    {
      "when": {
        "stage": [
          "门一"
        ]
      },
      "note": "门一 findings 推翻方案前提（前提攻击/砍刀/锚点类命中根前提）导致方案重写的：重写后必须整套重派门一（含砍刀，全组合重派不增量复审）——重写后的方案对未重审部分等于免检；台账 advance 记第二轮门一。重派即终轮：门一合计上限两轮，第二轮后无论余留直接进施工——余留只能是转抄/落点级，由门二对净 diff 兜底（mech4-settle 实证：架构在第 1 轮满配翻转、第 3 轮起复核抓的主要是方案文档自相矛盾，轮数堆不出质量）"
    },
    {
      "when": {
        "stage": [
          "门二"
        ]
      },
      "note": "三问不进基组合、按批触发加挂：迁移/口径搬移面→蜕变关系问；新状态机/不变量面→性质测试问；查询或循环放大面→性能放大问——触发面都不沾就不挂（用户拍板大砍：门二六路裁三路常驻＝设计七维·终审＋连带面＋砍刀·diff）"
    },
    {
      "when": {
        "stage": [
          "门二"
        ]
      },
      "note": "门二阻断修复不整套重派：修正轮清单发回原施工者统一执行（含跨段文件，避免多人同文件冲突），主会话亲核阻断修复面＋机器门全绿即提交；仅当修复本身推翻设计前提才回门一（回门一仍受两轮上限约束）"
    }
  ]
}
